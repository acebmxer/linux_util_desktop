{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linux_Util Desktop",
  "version": "0.0.0",
  "identifier": "io.github.acebmxer.linux-util-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Linux_Util Desktop",
        "width": 1000,
        "height": 700,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "category": "System",
    "shortDescription": "Desktop front end for linux_util"
  }
}
